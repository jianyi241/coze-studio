      ],
      "expected_chunk_ids": ["chunk_a1", "chunk_e1"]
    },
    {
      "id": "Q11",
      "cq": "CQ3",
      "hops": 2,
      "type": "multi_hop",
      "question": "knowledge 模块依赖哪个外部组件来做编排？",
      "expected_answer": "Eino",
      "expected_entities": ["mod_knowledge", "comp_eino"],
      "expected_evidence_paths": [["mod_knowledge", "dependsOn", "comp_eino"]],
      "expected_chunk_ids": ["chunk_e1"]
    },
    {
      "id": "Q12",
      "cq": "CQ8",
      "hops": 2,
      "type": "multi_hop",
      "question": "与 Hybrid RAG 相关、且有文档支撑的 API 有哪些？",
      "expected_answer": "ontologyRetrieveNode（以及 Retrieve 实现 Hybrid RAG）",
      "expected_entities": ["concept_hybrid_rag", "api_ontology_node", "mod_knowledge"],
      "expected_evidence_paths": [
        ["api_ontology_node", "relatedTo", "concept_hybrid_rag"],
        ["api_ontology_node", "documentedIn", "docent_r2"]
      ],
      "expected_chunk_ids": ["chunk_r2", "chunk_r1"]
    },
    {
      "id": "Q13",
      "cq": "CQ7",
      "hops": 2,
      "type": "multi_hop",
      "question": "要从索引写入走到本体召回数据可用，配置/调用顺序上应先完成什么？",
      "expected_answer": "先成功执行 indexSlicesInSearchStores（其 precedes ontologyRetrieveNode）",
      "expected_entities": ["api_index_slices", "api_ontology_node", "cstr_hook_after_index"],
      "expected_evidence_paths": [
        ["api_index_slices", "precedes", "api_ontology_node"],
        ["api_index_slices", "constrainedBy", "cstr_hook_after_index"]
