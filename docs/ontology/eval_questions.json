{
  "ontology_id": "coze.lite.software_kb",
  "version": "0.1.0",
  "knowledge_id": "demo_software_kb",
  "baselines": ["vector_only", "vector_plus_ontology"],
  "metrics": ["answer_accuracy", "faithfulness", "multihop_accuracy", "explainability_path_rate", "illegal_triple_reject_rate"],
  "notes": "Expand CQ1–CQ10 into runnable items. expected_evidence_paths use entity ids from golden_triples.json. For vector_only, multihop/adversarial items are expected weaker.",
  "questions": [
    {
      "id": "Q1",
      "cq": "CQ1",
      "hops": 1,
      "type": "single_hop",
      "question": "knowledge 模块属于哪个组件？",
      "aliases": ["domain/knowledge 从属于什么？"],
      "expected_answer": "Coze Studio",
      "expected_entities": ["mod_knowledge", "comp_coze_studio"],
      "expected_evidence_paths": [["mod_knowledge", "partOf", "comp_coze_studio"]],
      "expected_chunk_ids": ["chunk_r1"]
    },
    {
      "id": "Q2",
      "cq": "CQ1",
      "hops": 1,
      "type": "single_hop",
      "question": "Retrieve 接口属于哪个模块？",
      "expected_answer": "knowledge",
      "expected_entities": ["api_retrieve", "mod_knowledge"],
      "expected_evidence_paths": [["api_retrieve", "partOf", "mod_knowledge"]],
      "expected_chunk_ids": ["chunk_r1"]
    },
    {
      "id": "Q3",
      "cq": "CQ4",
      "hops": 1,
      "type": "single_hop",
      "question": "「倒数排名融合」指的是哪个概念？",
      "expected_answer": "RRF",
      "expected_entities": ["concept_rrf"],
      "expected_evidence_paths": [],
      "expected_chunk_ids": ["chunk_r1"],
      "linking": {"alias": "倒数排名融合", "entity_id": "concept_rrf"}
    },
    {
      "id": "Q4",
      "cq": "CQ6",
      "hops": 1,
      "type": "single_hop",
      "question": "切片 chunk_r2 主要支撑了哪一个 API 实体？",
      "expected_answer": "ontologyRetrieveNode",
      "expected_entities": ["api_ontology_node", "docent_r2"],
      "expected_evidence_paths": [["api_ontology_node", "documentedIn", "docent_r2"]],
      "expected_chunk_ids": ["chunk_r2"]
    },
    {
      "id": "Q5",
      "cq": "CQ7",
      "hops": 1,
      "type": "single_hop",
      "question": "在 Retrieve 流水线里，查询重写相对检索入口的顺序关系是什么？",
      "expected_answer": "Query Rewrite 前置于 Retrieve",
      "expected_entities": ["concept_query_rewrite", "api_retrieve"],
      "expected_evidence_paths": [["concept_query_rewrite", "precedes", "api_retrieve"]],
      "expected_chunk_ids": ["chunk_r1"]
    },
    {
      "id": "Q6",
      "cq": "CQ1",
      "hops": 1,
      "type": "single_hop",
      "question": "node_retriever 属于哪个模块？",
      "expected_answer": "agent",
      "expected_entities": ["api_node_retriever", "mod_agent"],
      "expected_evidence_paths": [["api_node_retriever", "partOf", "mod_agent"]],
      "expected_chunk_ids": ["chunk_a1"]
    },
    {
      "id": "Q7",
      "cq": "CQ6",
      "hops": 1,
      "type": "single_hop",
      "question": "Eino 组件在哪篇文档切片里被说明？",
      "expected_answer": "chunk_e1 / doc_eino",
      "expected_entities": ["comp_eino", "docent_e1"],
      "expected_evidence_paths": [["comp_eino", "documentedIn", "docent_e1"]],
      "expected_chunk_ids": ["chunk_e1"]
    },
    {
      "id": "Q8",
      "cq": "CQ2",
      "hops": 2,
      "type": "multi_hop",
      "question": "调用 ontologyRetrieveNode 需要满足哪些约束？",
      "expected_answer": "ONTOLOGY_RAG_ENABLED 默认关闭，开启后才走图召回",
      "expected_entities": ["api_ontology_node", "cstr_flag_default_off"],
      "expected_evidence_paths": [["api_ontology_node", "constrainedBy", "cstr_flag_default_off"]],
      "expected_chunk_ids": ["chunk_c1", "chunk_r2"]
    },
    {
      "id": "Q9",
      "cq": "CQ2",
      "hops": 2,
      "type": "multi_hop",
      "question": "Retrieve 接口受哪些约束影响（给出约束名）？",
      "expected_answer": "ONTOLOGY_RAG_ENABLED_default_off",
      "expected_entities": ["api_retrieve", "cstr_flag_default_off"],
      "expected_evidence_paths": [["api_retrieve", "constrainedBy", "cstr_flag_default_off"]],
      "expected_chunk_ids": ["chunk_c1"]
    },
    {
      "id": "Q10",
      "cq": "CQ3",
      "hops": 2,
      "type": "multi_hop",
