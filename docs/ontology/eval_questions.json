      "expected_entities": [],
      "expected_evidence_paths": [],
      "expected_chunk_ids": [],
      "expect_refuse": true,
      "unanswerable": true
    },
    {
      "id": "Q20",
      "cq": "CQ9",
      "hops": 0,
      "type": "adversarial",
      "question": "ontologyRetrieveNode 是否 dependsOn workflow 模块？",
      "expected_answer": "无此三元组/路径，应拒答。",
      "expected_entities": ["api_ontology_node", "mod_workflow"],
      "expected_evidence_paths": [],
      "expect_refuse": true,
      "unanswerable": true
    },
    {
      "id": "Q21",
      "cq": "CQ5",
      "hops": 1,
      "type": "adversarial",
      "question": "若抽取出 predicate=fooBar 的边，系统应如何处理？",
      "expected_answer": "非白名单关系，拒绝入库。",
      "expected_entities": ["cstr_reject_illegal_triple"],
      "expected_evidence_paths": [["mod_knowledge", "constrainedBy", "cstr_reject_illegal_triple"]],
      "expected_chunk_ids": ["chunk_c2"],
      "expect_reject_or_refuse": true
    },
    {
      "id": "Q22",
      "cq": "CQ4",
      "hops": 1,
      "type": "single_hop",
