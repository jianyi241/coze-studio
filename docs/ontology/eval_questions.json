    {
      "id": "Q14",
      "cq": "CQ10",
      "hops": 2,
      "type": "multi_hop",
      "question": "为什么重排阶段可能用到 RRF？请用 Retrieve 相关路径解释。",
      "expected_answer": "Retrieve 与 RRF 相关，流水线在多路召回后经 RRF 重排",
      "expected_entities": ["api_retrieve", "concept_rrf"],
      "expected_evidence_paths": [["api_retrieve", "relatedTo", "concept_rrf"]],
      "expected_chunk_ids": ["chunk_r1"],
      "require_explainability": true
    },
    {
      "id": "Q15",
      "cq": "CQ3",
      "hops": 2,
      "type": "multi_hop",
      "question": "workflow 模块属于 Coze Studio 吗？依据是什么？",
      "expected_answer": "属于；workflow partOf Coze Studio",
      "expected_entities": ["mod_workflow", "comp_coze_studio"],
      "expected_evidence_paths": [["mod_workflow", "partOf", "comp_coze_studio"]],
      "expected_chunk_ids": ["chunk_a1"]
    },
    {
      "id": "Q16",
      "cq": "CQ2",
      "hops": 2,
      "type": "multi_hop",
      "question": "knowledge 模块在非法三元组方面受到什么约束？",
      "expected_answer": "reject_illegal_triple：非法三元组必须拒收入库",
      "expected_entities": ["mod_knowledge", "cstr_reject_illegal_triple"],
      "expected_evidence_paths": [["mod_knowledge", "constrainedBy", "cstr_reject_illegal_triple"]],
      "expected_chunk_ids": ["chunk_c2"]
    },
    {
      "id": "Q17",
      "cq": "CQ8",
      "hops": 2,
      "type": "multi_hop",
      "question": "Retrieve 与 Query Rewrite 的关系是什么，文档依据在哪？",
      "expected_answer": "relatedTo；依据 chunk_r1",
      "expected_entities": ["api_retrieve", "concept_query_rewrite", "docent_r1"],
      "expected_evidence_paths": [
        ["api_retrieve", "relatedTo", "concept_query_rewrite"],
        ["api_retrieve", "documentedIn", "docent_r1"]
      ],
      "expected_chunk_ids": ["chunk_r1"]
    },
    {
      "id": "Q18",
      "cq": "CQ5",
      "hops": 1,
      "type": "adversarial",
      "question": "能否把三元组 (Retrieve, dependsOn, Eino) 写入本体库？为什么？",
      "expected_answer": "不能。dependsOn 的 domain 不含 API，属于非法三元组，应拒绝。",
      "expected_entities": ["cstr_reject_illegal_triple"],
      "expected_evidence_paths": [["mod_knowledge", "constrainedBy", "cstr_reject_illegal_triple"]],
      "expected_chunk_ids": ["chunk_c2"],
      "expect_reject_or_refuse": true,
      "negative_triple": {"subject": "api_retrieve", "predicate": "dependsOn", "object": "comp_eino"}
    },
    {
      "id": "Q19",
      "cq": "CQ9",
      "hops": 0,
      "type": "adversarial",
      "question": "Milvus 是否 partOf knowledge 模块？",
