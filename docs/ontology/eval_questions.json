      "expected_chunk_ids": ["chunk_r1"]
    },
    {
      "id": "Q23",
      "cq": "CQ10",
      "hops": 2,
      "type": "multi_hop",
      "question": "请解释为何可以说 knowledge 实现了 Hybrid RAG，并给出文档切片。",
      "expected_answer": "mod_knowledge implements concept_hybrid_rag，文档见于 chunk_r1",
      "expected_entities": ["mod_knowledge", "concept_hybrid_rag", "docent_r1"],
      "expected_evidence_paths": [
        ["mod_knowledge", "implements", "concept_hybrid_rag"],
        ["mod_knowledge", "documentedIn", "docent_r1"]
      ],
      "expected_chunk_ids": ["chunk_r1"],
      "require_explainability": true
    },
    {
      "id": "Q24",
      "cq": "CQ2",
      "hops": 2,
